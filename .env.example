# Optional Docker Compose settings
COMPOSE_PROJECT_NAME=codeverta-erp

# Required only when docker-compose.multitenant.yml is enabled.
# Generate independent random values; never commit the resulting .env file.
# PLATFORM_DB_PASSWORD=<strong-random-password>
# MYSQL_ROOT_PASSWORD=<existing-mariadb-root-password>
# TENANT_CREDENTIAL_KEY=<output-of: openssl rand -base64 32>
# PLATFORM_JWT_SECRET=<output-of: openssl rand -base64 64>
# TENANT_PLATFORM_DOMAIN_SUFFIX=erp.example.com
# PLATFORM_ADMIN_HOST=admin.example.com
