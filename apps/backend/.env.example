PORT=8084
GIN_MODE=debug
JWT_SECRET=replace-with-at-least-64-random-characters
SESSION_SECRET=replace-with-a-different-random-secret
SQL_DSN=codeverta:change-me@tcp(mysql:3306)/codeverta_erp?charset=utf8mb4&parseTime=True&loc=Local
REDIS_CONN_STRING=redis://redis:6379/0
DB_ENCRYPTION_KEY=replace-with-exactly-32-random-bytes
DB_HMAC_KEY=replace-with-a-random-hmac-secret
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
DISCORD_WEBHOOK_URL=
DISPATCHER_WEBHOOK_SECRET=
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
# Meta Messaging: WhatsApp Cloud API, Instagram Messaging, dan Messenger.
# Set callback URL ke /api/crm/webhooks/meta_messaging?tenant_id=<TENANT_UUID>.
META_GRAPH_API_VERSION=v26.0
META_ACCESS_TOKEN=
# Token per kanal opsional; jika kosong, META_ACCESS_TOKEN digunakan.
META_WHATSAPP_ACCESS_TOKEN=
META_FACEBOOK_PAGE_ACCESS_TOKEN=
META_INSTAGRAM_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_FACEBOOK_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
# Public landing URL used only for Xendit success/failure redirects.
STORE_FRONTEND_URL=http://localhost:5173
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:8084/api/auth/google/callback
GOOGLE_OAUTH_FRONTEND_URL=http://localhost:5173
